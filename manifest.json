{
  "manifest_version": 3,
  "name": "Anime Downloader",
  "version": "1.0",
  "description": "Add helper keyboard shortcuts for Animeblkom.",
  "permissions": ["tabs", "scripting"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "navigate-to-next-episode": {
      "suggested_key": {
        "default": "Ctrl+Shift+U"
      },
      "description": "Navigate to the next episode"
    },
    "download-episode": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Download the current episode"
    },
    "next-resolution": {
      "suggested_key": {
        "default": "Ctrl+Shift+E"
      },
      "description": "Change the resolution for the current episode to the next resolution. The resolutions are circular, so if you are at the highest resolution, it will go back to the lowest resolution"
    }
  },
    "action": {
    "default_title": "Anime Downloader"
  },
  "host_permissions": [
    "*://www.animeblkom.com/*",
    "*://bkvideo.site/*",
    "*://anime3rb.com/*",
    "*://video.vid3rb.com/*"
  ]
}
